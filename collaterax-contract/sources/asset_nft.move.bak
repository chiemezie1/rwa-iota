
#[allow(unused_use, unused_const, duplicate_alias)]
module collaterax::asset_nft {
    use std::string::{String, utf8};
    use std::error;
    use std::signer;
    use std::vector;
    use iota::object::{Self, UID};
    use iota::tx_context::{Self, TxContext};
    use iota::table::{Self, Table};
    use std::vector;
    use std::error;
    use std::signer;
    use iota::object::{Self, UID};
    use iota::tx_context::{Self, TxContext};
    use iota::table::{Self, Table};
    use collaterax::spv_registry::{Self, SPVRegistry};

    /// Error codes
    const E_NOT_AUTHORIZED: u64 = 1;
    const E_ASSET_ALREADY_EXISTS: u64 = 2;
    const E_ASSET_NOT_FOUND: u64 = 3;
    const E_NOT_OWNER: u64 = 4;
    const E_STORE_ALREADY_EXISTS: u64 = 5;
    const E_NOT_BURNABLE: u64 = 6;
    const E_INVALID_METADATA: u64 = 7;

    /// Represents a unique real-world asset as an NFT
    public struct AssetNFT has key, store {
        /// Unique identifier for the asset
        id: UID,
        /// Asset identifier (e.g., property address, deed number)
        asset_id: String,
        /// Type of asset (e.g., "real_estate", "artwork", "vehicle")
        asset_type: String,
        /// Title of the asset
        title: String,
        /// Description of the asset
        description: String,
        /// JSON string containing additional metadata
        metadata: String,
        /// Address of the SPV that verified this asset
        spv_address: address,
        /// Address of the current owner
        owner: address,
        /// Whether this NFT can be burned
        burnable: bool,
        /// Whether this NFT can be fractionalized
        fractionalizable: bool,
        /// Timestamp when the asset was created
        created_at: u64,
        /// Timestamp when the asset was last updated
        updated_at: u64
    }

    /// Global store for all asset NFTs
    public struct AssetStore has key {
        id: UID,
        /// Table mapping asset IDs to their NFTs
        id: UID,
        id: UID,
        assets: Table<String, AssetNFT>,
        /// List of all asset IDs for enumeration
        asset_ids: vector<String>,
        /// Address of the admin
        admin: address
    }

    /// Initialize the asset store
    /// Can only be called once by the platform admin
    public entry fun init_store(admin: &signer, ctx: &mut TxContext) {
        let admin_address = signer::address_of(admin);
        
        // Create a new asset store
        let store = AssetStore {
            assets: table::new(ctx),
            asset_ids: vector::empty<String>(),
            admin: admin_address
        };
        
        // Move the store to the global storage
        object::share_object(store);
    }

    /// Create a new asset NFT
    /// Only verified SPVs can create new assets
    public entry fun create_asset(
        spv: &signer,
        asset_id: vector<u8>,
        asset_type: vector<u8>,
        title: vector<u8>,
        description: vector<u8>,
        metadata: vector<u8>,
        burnable: bool,
        fractionalizable: bool,
        store: &mut AssetStore,
        registry: &SPVRegistry,
        ctx: &mut TxContext
    ) {
        let spv_address = signer::address_of(spv);
        
        // Ensure the SPV is verified
        assert!(spv_registry::is_verified_spv(spv_address, registry), error::permission_denied(E_NOT_AUTHORIZED));
        
        let asset_id_str = utf8(asset_id);
        
        // Ensure the asset doesn't already exist
        assert!(!table::contains(&store.assets, asset_id_str), error::already_exists(E_ASSET_ALREADY_EXISTS));
        
        // Create a new asset NFT
        let asset = AssetNFT {
            id: object::new(ctx),
            asset_id: asset_id_str,
            asset_type: utf8(asset_type),
            title: utf8(title),
            description: utf8(description),
            metadata: utf8(metadata),
            spv_address: spv_address,
            owner: spv_address, // Initially owned by the SPV
            burnable: burnable,
            fractionalizable: fractionalizable,
            created_at: tx_context::epoch_timestamp_ms(ctx),
            updated_at: tx_context::epoch_timestamp_ms(ctx)
        };
        
        // Add the asset to the store
        table::add(&mut store.assets, asset_id_str, asset);
        vector::push_back(&mut store.asset_ids, asset_id_str);
    }

    /// Transfer an asset NFT to a new owner
    public entry fun transfer_asset(
        owner: &signer,
        asset_id: vector<u8>,
        new_owner: address,
        store: &mut AssetStore,
        ctx: &mut TxContext
    ) {
        let owner_address = signer::address_of(owner);
        let asset_id_str = utf8(asset_id);
        
        // Ensure the asset exists
        assert!(table::contains(&store.assets, asset_id_str), error::not_found(E_ASSET_NOT_FOUND));
        
        // Ensure the caller is the current owner
        let asset = table::borrow_mut(&mut store.assets, asset_id_str);
        assert!(asset.owner == owner_address, error::permission_denied(E_NOT_OWNER));
        
        // Update the owner
        asset.owner = new_owner;
        asset.updated_at = tx_context::epoch_timestamp_ms(ctx);
    }

    /// Update asset metadata
    /// Only the current owner can update metadata
    public entry fun update_asset_metadata(
        owner: &signer,
        asset_id: vector<u8>,
        title: vector<u8>,
        description: vector<u8>,
        metadata: vector<u8>,
        store: &mut AssetStore,
        ctx: &mut TxContext
    ) {
        let owner_address = signer::address_of(owner);
        let asset_id_str = utf8(asset_id);
        
        // Ensure the asset exists
        assert!(table::contains(&store.assets, asset_id_str), error::not_found(E_ASSET_NOT_FOUND));
        
        // Ensure the caller is the current owner
        let asset = table::borrow_mut(&mut store.assets, asset_id_str);
        assert!(asset.owner == owner_address, error::permission_denied(E_NOT_OWNER));
        
        // Update the metadata
        asset.title = utf8(title);
        asset.description = utf8(description);
        asset.metadata = utf8(metadata);
        asset.updated_at = tx_context::epoch_timestamp_ms(ctx);
    }

    /// Burn an asset NFT
    /// Only the current owner can burn an asset, and only if it's marked as burnable
    public entry fun burn_asset(
        owner: &signer,
        asset_id: vector<u8>,
        store: &mut AssetStore,
        ctx: &mut TxContext
    ) {
        let owner_address = signer::address_of(owner);
        let asset_id_str = utf8(asset_id);
        
        // Ensure the asset exists
        assert!(table::contains(&store.assets, asset_id_str), error::not_found(E_ASSET_NOT_FOUND));
        
        // Get the asset
        let asset = table::borrow(&store.assets, asset_id_str);
        
        // Ensure the caller is the current owner
        assert!(asset.owner == owner_address, error::permission_denied(E_NOT_OWNER));
        
        // Ensure the asset is burnable
        assert!(asset.burnable, error::invalid_argument(E_NOT_BURNABLE));
        
        // Remove the asset from the store
        let AssetNFT { id, id,
            id: id,
            asset_id: id,
            asset_type: _,
            title: _,
            description: _,
            metadata: _,
            spv_address: _,
            owner: _,
            burnable: _,
            fractionalizable: _,
            created_at: _,
            updated_at: _
        } = table::remove(&mut store.assets, asset_id_str);
        
        // Remove the asset ID from the list
        let (found, index) = vector::index_of(&store.asset_ids, &asset_id_str);
        if (found) {
            vector::remove(&mut store.asset_ids, index);
        };
    }

    /// Get the number of assets
    public fun get_asset_count(store: &AssetStore): u64 {
        vector::length(&store.asset_ids)
    }

    /// Get an asset ID by index
    public fun get_asset_id_by_index(store: &AssetStore, index: u64): String {
        *vector::borrow(&store.asset_ids, index)
    }

    /// Check if an address is the owner of an asset
    public fun is_owner(
        address: address,
        asset_id: String,
        store: &AssetStore
    ): bool {
        if (!table::contains(&store.assets, asset_id)) {
            return false
        };
        
        let asset = table::borrow(&store.assets, asset_id);
        asset.owner == address
    }

    /// Get asset information
    public fun get_asset_info(
        asset_id: String,
        store: &AssetStore
    ): (String, String, String, String, address, address, bool, bool, u64, u64) {
        assert!(table::contains(&store.assets, asset_id), error::not_found(E_ASSET_NOT_FOUND));
        
        let asset = table::borrow(&store.assets, asset_id);
        (
            asset.asset_type,
            asset.title,
            asset.description,
            asset.metadata,
            asset.spv_address,
            asset.owner,
            asset.burnable,
            asset.fractionalizable,
            asset.created_at,
            asset.updated_at
        )
    }
}
